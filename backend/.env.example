# Copy to backend/.env; Start-Backend.ps1 reads this file. Never commit the real token.
SPACEFIT_TOKEN=replace-with-a-long-random-token
SPACEFIT_HOST=127.0.0.1
SPACEFIT_PORT=8000
# Absolute paths to real executables; omit if installed on PATH.
COLMAP_BIN=colmap
OPENMVS_BIN_DIR=
BLENDER_BIN=blender
SPACEFIT_USE_GPU=0
SPACEFIT_THREADS=4
SPACEFIT_MIN_IMAGES=50
SPACEFIT_MAX_IMAGES=150
SPACEFIT_MAX_UPLOAD_MB=1024
SPACEFIT_STAGE_TIMEOUT=7200
# Start-Backend/doctor auto-select Docker when the corresponding verified config exists.
# Set either variable explicitly to native to roll back only that tool group.
# SPACEFIT_OPENMVS_RUNTIME=docker
# SPACEFIT_COLMAP_RUNTIME=docker
# SPACEFIT_COLMAP_DOCKER_CONFIG=E:/ar-spacefit/backend/native-colmap-docker.json
